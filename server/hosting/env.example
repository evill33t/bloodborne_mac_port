# Copy to .env next to docker-compose.yml. Put the restic password in secrets/restic-password.
BACKUP_TOOL=restic
BACKUP_INTERVAL=3600
# Backblaze B2 (S3 API):
RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/your-bucket/shadnet
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# or a Hetzner Storage Box over SFTP (needs an ssh key + config in the sidecar):
# RESTIC_REPOSITORY=sftp:u123456@u123456.your-storagebox.de:shadnet
HEALTHCHECK_URL=
SHADNET_MEM_LIMIT=2g
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
