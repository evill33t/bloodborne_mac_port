    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SmithboxRoot)/src/Andre/Andre.Core/Game.cs" Link="Smithbox/Game.cs" />
    <Compile Include="$(SmithboxRoot)/src/Andre/Andre.Formats/Util/ArchiveKeys.cs" Link="Smithbox/ArchiveKeys.cs" />
    <Reference Include="Andre.SoulsFormats"><HintPath>$(SmithboxOutput)/Andre.SoulsFormats.dll</HintPath></Reference>
